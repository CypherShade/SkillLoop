# Base URL of the API. Leave as /api to use the Vite dev proxy locally and the
# Vercel rewrite in production (keeps the refresh cookie first-party).
# Set a full URL (e.g. https://skillloop-api.onrender.com/api) to call the API directly;
# then set COOKIE_SAMESITE=none on the server.
VITE_API_URL=/api
