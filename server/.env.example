# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- Database (Neon Postgres) ----
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- JWT ----
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# ---- CORS / cookies ----
# Comma-separated list of allowed browser origins
CLIENT_ORIGINS=http://localhost:5173
# lax (same-site / proxied frontend) or none (frontend on a different site; requires HTTPS)
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the app (Render = 1)
TRUST_PROXY=1

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@skillloop.dev
SEED_ADMIN_PASSWORD=Admin@12345
